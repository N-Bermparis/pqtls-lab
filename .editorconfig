root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cc,cpp,h,hh,hpp}]
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json,jsonl}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{sh,bash}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[Makefile]
indent_style = tab
